@startuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam classAttributeIconSize 0
enum RolUsuario {
  Admin
  Docente
}
class Usuario {
  +Id : int
  +NombreUsuario : string
  +PasswordHash : string
  +Rol : RolUsuario
  +DocenteId : int?
}
class Docente {
  +Id : int
  +Nombre : string
  +Correo : string
  +Departamento : string
}
class Estudiante {
  +Id : int
  +Nombre : string
  +Codigo : string
}
class ArticuloCientifico {
  +Id : int
  +Titulo : string
  +Autores : string
  +Revista : string
  +Anio : int
  +Resumen : string
}
class GrupoExposicion {
  +Id : int
  +Nombre : string
  +Orden : int
  +FechaExposicion : DateTime?
}
class Evaluacion {
  +Id : int
  +Nota : decimal?
  +Observaciones : string?
  +FechaCalificacion : DateTime?
  +EstaCalificada : bool
  +Calificar(nota, observaciones) : void
}
Usuario --> RolUsuario
Usuario "0..1" -- "0..1" Docente
GrupoExposicion "*" --> "1" ArticuloCientifico
GrupoExposicion "*" --> "1" Docente : asesor
Estudiante "*" --> "0..1" GrupoExposicion
Evaluacion "*" --> "1" GrupoExposicion
Evaluacion "*" --> "1" Docente : evaluador
@enduml
