{
  "openapi": "3.0.1",
  "info": {
    "title": "API Académica",
    "version": "v1"
  },
  "paths": {
    "/api/Auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UsuarioLoginDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/UsuarioLoginDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/UsuarioLoginDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Proceso/docente/asignar-manual": {
      "post": {
        "tags": [
          "Proceso"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AsignacionManualDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/AsignacionManualDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/AsignacionManualDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Proceso/docente/mis-grupos": {
      "get": {
        "tags": [
          "Proceso"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Proceso/estudiante/mi-grupo": {
      "get": {
        "tags": [
          "Proceso"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Proceso/admin/consolidado": {
      "get": {
        "tags": [
          "Proceso"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Proceso/articulos": {
      "get": {
        "tags": [
          "Proceso"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AsignacionManualDto": {
        "type": "object",
        "properties": {
          "grupoId": {
            "type": "integer",
            "format": "int32"
          },
          "articuloId": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "UsuarioLoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "nullable": true
          },
          "password": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "apiKey",
        "description": "Ingresa el token en este formato: Bearer {tu_token}",
        "name": "Authorization",
        "in": "header"
      }
    }
  },
  "security": [
    {
      "Bearer": [ ]
    }
  ]
}